{
    "config_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "",
        "title": "$default",
        "type": "object",
        "properties": {
            "reading_type": {
                "enum": [
                    "Level Reading",
                    "Filled Percentage",
                    "Volume"
                ],
                "title": "Reading Type",
                "x-name": "reading_type",
                "x-hidden": false,
                "type": [
                    "string",
                    "null"
                ],
                "x-required": false,
                "description": "Which reading to display and alarm on: the level/depth, the filled percentage, or the volume. Focuses the UI on that single reading and points the alarm at it.",
                "default": "Filled Percentage",
                "x-position": 0
            },
            "sensor_maximum_metres": {
                "title": "Sensor Maximum Metres",
                "x-name": "sensor_maximum_metres",
                "x-hidden": false,
                "type": "number",
                "x-required": true,
                "description": "Maximum sensor depth (m)",
                "x-position": 1
            },
            "full_level": {
                "title": "Full Level",
                "x-name": "full_level",
                "x-hidden": false,
                "type": "number",
                "x-required": true,
                "description": "Level reading when full (m)",
                "x-position": 2
            },
            "input_units": {
                "enum": [
                    "mA",
                    "V",
                    "raw"
                ],
                "title": "Input Units",
                "x-name": "input_units",
                "x-hidden": false,
                "type": [
                    "string",
                    "null"
                ],
                "x-required": false,
                "description": "Units of the raw analog input reading.",
                "default": "mA",
                "x-position": 3
            },
            "sensor_minimum_ma": {
                "title": "Sensor Minimum Input",
                "x-name": "sensor_minimum_ma",
                "x-hidden": false,
                "type": [
                    "number",
                    "null"
                ],
                "x-required": false,
                "description": "Minimum raw sensor input in the configured input units.",
                "default": 4.0,
                "x-position": 4
            },
            "sensor_maximum_ma": {
                "title": "Sensor Maximum Input",
                "x-name": "sensor_maximum_ma",
                "x-hidden": false,
                "type": [
                    "number",
                    "null"
                ],
                "x-required": false,
                "description": "Maximum raw sensor input in the configured input units.",
                "default": 20.0,
                "x-position": 5
            },
            "sensor_minimum_metres": {
                "title": "Sensor Minimum Metres",
                "x-name": "sensor_minimum_metres",
                "x-hidden": false,
                "type": [
                    "number",
                    "null"
                ],
                "x-required": false,
                "description": "Minimum sensor depth (m). For submersible sensors, the sensor's mounting height above the tank floor (negative if below it)",
                "default": 0.0,
                "x-position": 6
            },
            "empty_level": {
                "title": "Empty Level",
                "x-name": "empty_level",
                "x-hidden": false,
                "type": [
                    "number",
                    "null"
                ],
                "x-required": false,
                "description": "Level reading when empty (m)",
                "default": 0.0,
                "x-position": 7
            },
            "sensor_type": {
                "enum": [
                    "Submersible",
                    "Radar",
                    "Radar Inverted"
                ],
                "title": "Sensor Type",
                "x-name": "sensor_type",
                "x-hidden": false,
                "type": [
                    "string",
                    "null"
                ],
                "x-required": false,
                "description": "Type of sensor. Radar inverted reads like a submersible sensor.",
                "default": "Submersible",
                "x-position": 10
            },
            "fluid_density": {
                "title": "Fluid Density",
                "x-name": "fluid_density",
                "x-hidden": false,
                "type": [
                    "number",
                    "null"
                ],
                "x-required": false,
                "description": "Density of the measured fluid (kg/m³). Submersible (pressure) sensors are ranged in metres of water, so readings are scaled by 1000 / density. Ignored for radar sensors. Defaults to water.",
                "default": 1000.0,
                "x-position": 10,
                "minimum": 1.0
            },
            "volume_curve": {
                "title": "Volume Curve",
                "x-name": "volume_curve",
                "x-hidden": false,
                "type": "array",
                "x-required": true,
                "x-position": 11,
                "items": {
                    "title": "Volume Curve Point",
                    "x-name": "volume_curve_point",
                    "x-hidden": false,
                    "type": "object",
                    "x-required": true,
                    "properties": {
                        "level": {
                            "title": "Level",
                            "x-name": "level",
                            "x-hidden": false,
                            "type": "number",
                            "x-required": true,
                            "description": "Level / depth in metres",
                            "x-position": 1
                        },
                        "volume": {
                            "title": "Volume",
                            "x-name": "volume",
                            "x-hidden": false,
                            "type": "number",
                            "x-required": true,
                            "description": "Volume in configured volume units",
                            "x-position": 2
                        }
                    },
                    "additionalElements": true,
                    "required": [
                        "level",
                        "volume"
                    ],
                    "x-collapsible": true,
                    "x-defaultCollapsed": false
                }
            },
            "hide_volume": {
                "title": "Hide Volume",
                "x-name": "hide_volume",
                "x-hidden": false,
                "type": [
                    "boolean",
                    "null"
                ],
                "x-required": false,
                "description": "Whether to hide the tank volume in the UI",
                "default": true,
                "x-position": 12
            },
            "max_volume": {
                "title": "Max Volume",
                "x-name": "max_volume",
                "x-hidden": false,
                "type": [
                    "number",
                    "null"
                ],
                "x-required": false,
                "description": "Maximum tank volume in the configured volume units, used when no volume curve is configured",
                "default": 100000.0,
                "x-position": 13
            },
            "volume_units": {
                "title": "Volume Units",
                "x-name": "volume_units",
                "x-hidden": false,
                "type": [
                    "string",
                    "null"
                ],
                "x-required": false,
                "description": "Units to display the volume reading in (e.g. L, kL, gal)",
                "default": "L",
                "x-position": 14
            },
            "depth_units": {
                "enum": [
                    "m",
                    "cm",
                    "mm",
                    "in",
                    "ft"
                ],
                "title": "Depth Units",
                "x-name": "depth_units",
                "x-hidden": false,
                "type": [
                    "string",
                    "null"
                ],
                "x-required": false,
                "description": "Units for the Level Reading gauge, and, when Reading Type is Level Reading, for the alarm slider and alarm message. The level_reading tag itself stays in metres for peer consumers (e.g. the Petronash HMI); a copy converted to this unit is published as the level_reading_display tag. Changing this unit gives a level alarm a fresh, unset Alarm Point slider on the new scale rather than reinterpreting the old setpoint as the new unit: the alarm stays quiet until the point is set again. Each unit keeps its own setpoint, so changing back restores the previous one.",
                "default": "m",
                "x-position": 14
            },
            "volume_decimal_precision": {
                "title": "Volume Decimal Precision",
                "x-name": "volume_decimal_precision",
                "x-hidden": false,
                "type": [
                    "integer",
                    "null"
                ],
                "x-required": false,
                "description": "Number of decimal places to show for the volume reading",
                "default": 0,
                "x-position": 15
            },
            "ai_pin": {
                "title": "AI Pin",
                "x-name": "ai_pin",
                "x-hidden": false,
                "type": "integer",
                "x-required": true,
                "description": "Analog input pin number",
                "x-position": 0
            },
            "power_pin": {
                "title": "Power Pin",
                "x-name": "power_pin",
                "x-hidden": false,
                "type": [
                    "integer",
                    "null"
                ],
                "x-required": false,
                "description": "Digital output pin to power the sensor",
                "default": null,
                "x-position": 8
            },
            "polling_frequency": {
                "title": "Polling Frequency",
                "x-name": "polling_frequency",
                "x-hidden": false,
                "type": [
                    "number",
                    "null"
                ],
                "x-required": false,
                "description": "How often to poll the sensor (Hz)",
                "default": 1.0,
                "x-position": 9
            },
            "alarm_enabled": {
                "title": "Alarm Enabled",
                "x-name": "alarm_enabled",
                "x-hidden": false,
                "type": [
                    "boolean",
                    "null"
                ],
                "x-required": false,
                "description": "Send a notification when the reading crosses the alarm point",
                "default": false,
                "x-position": 17
            },
            "alarm_type": {
                "enum": [
                    "Greater Than",
                    "Less Than",
                    "Allowed Range"
                ],
                "title": "Alarm Type",
                "x-name": "alarm_type",
                "x-hidden": false,
                "type": [
                    "string",
                    "null"
                ],
                "x-required": false,
                "description": "Greater Than and Less Than alarm on a single point. Allowed Range alarms when the reading falls outside a low/high band.",
                "default": "Greater Than",
                "x-position": 18
            },
            "alarm_source": {
                "enum": [
                    "Level Reading",
                    "Filled Percentage",
                    "Volume"
                ],
                "title": "Alarm Source",
                "x-name": "alarm_source",
                "x-hidden": true,
                "type": [
                    "string",
                    "null"
                ],
                "x-required": false,
                "description": "Deprecated: superseded by Reading Type.",
                "default": "Level Reading",
                "x-position": 19,
                "deprecated": true
            },
            "alarm_slider_minimum": {
                "title": "Alarm Slider Minimum",
                "x-name": "alarm_slider_minimum",
                "x-hidden": false,
                "type": [
                    "number",
                    "null"
                ],
                "x-required": false,
                "description": "Lower bound of the alarm point slider, in the alarm's display units (the units shown on the slider; Depth Units for a level alarm). Defaults to the alarm source's minimum.",
                "default": null,
                "x-position": 20
            },
            "alarm_slider_maximum": {
                "title": "Alarm Slider Maximum",
                "x-name": "alarm_slider_maximum",
                "x-hidden": false,
                "type": [
                    "number",
                    "null"
                ],
                "x-required": false,
                "description": "Upper bound of the alarm point slider, in the alarm's display units (the units shown on the slider; Depth Units for a level alarm). Defaults to the alarm source's maximum.",
                "default": null,
                "x-position": 21
            },
            "alarm_grace_period_s": {
                "title": "Alarm Grace Period (s)",
                "x-name": "alarm_grace_period_s",
                "x-hidden": false,
                "type": [
                    "number",
                    "null"
                ],
                "x-required": false,
                "description": "How long the reading must stay out of bounds before notifying",
                "default": 30.0,
                "x-position": 22,
                "minimum": 0.0
            },
            "alarm_renotify_interval_s": {
                "title": "Alarm Re-notify Interval (s)",
                "x-name": "alarm_renotify_interval_s",
                "x-hidden": false,
                "type": [
                    "number",
                    "null"
                ],
                "x-required": false,
                "description": "How often to re-notify while the alarm remains active",
                "default": 900.0,
                "x-position": 23,
                "minimum": 0.0
            },
            "operator_calibration_enabled": {
                "title": "Operator Sensor Calibration",
                "x-name": "operator_calibration_enabled",
                "x-hidden": false,
                "type": [
                    "boolean",
                    "null"
                ],
                "x-required": false,
                "description": "Let operators set the zero (minimum level), span (maximum level) and fluid density on site, from the Sensor Calibration section of this app and the local HMI, without a redeploy. The Sensor Minimum Metres, Sensor Maximum Metres and Fluid Density above become the defaults that Reset to configured values returns to.",
                "default": false,
                "x-position": 24
            },
            "dv_app_position": {
                "title": "Position",
                "x-name": "dv_app_position",
                "x-hidden": true,
                "type": [
                    "integer",
                    "null"
                ],
                "x-required": false,
                "description": "Position of Application in UI Structure. Smaller numbers are closer to the top.",
                "default": 100,
                "x-position": 16,
                "minimum": 0
            }
        },
        "additionalElements": true,
        "required": [
            "sensor_maximum_metres",
            "full_level",
            "volume_curve",
            "ai_pin"
        ]
    },
    "ui_schema": {
        "displayString": "$config.app().APP_DISPLAY_NAME",
        "hidden": "$config.app().interpreter_hidden:boolean:false",
        "fullWidth": "$config.app().interpreter_full_width:boolean:false",
        "position": "$config.app().dv_app_position:number:100",
        "icon": null,
        "colour": null,
        "defaultOpen": "$config.app().dv_app_default_open:boolean",
        "type": "uiApplication",
        "name": "$config.app().APP_KEY",
        "children": {
            "sensor_fault_warning": {
                "name": "sensor_fault_warning",
                "type": "uiWarningIndicator",
                "displayString": "$tag.app().sensor_fault_message:string:\"Sensor signal below range \\u2014 check the sensor and its wiring\"",
                "position": 1,
                "hidden": "$tag.app().sensor_fault_hidden:boolean:true",
                "currentValue": "$cmds.app().sensor_fault_warning",
                "can_cancel": false
            },
            "level": {
                "name": "level",
                "type": "uiVariable",
                "displayString": "Level",
                "showActivity": true,
                "form": "radialGauge",
                "position": 52,
                "hidden": false,
                "units": "%",
                "varType": "float",
                "currentValue": "$tag.app().level_filled_percentage:number:null",
                "decPrecision": 1,
                "ranges": [
                    {
                        "min": 0,
                        "max": 15.0,
                        "colour": "blue",
                        "show_on_graph": true,
                        "label": "Low"
                    },
                    {
                        "min": 15.0,
                        "max": 100,
                        "colour": "green",
                        "show_on_graph": true,
                        "label": "Good"
                    }
                ],
                "live": true
            },
            "level_reading": {
                "name": "level_reading",
                "type": "uiVariable",
                "displayString": "Level Reading",
                "showActivity": true,
                "position": 53,
                "hidden": false,
                "units": "m",
                "varType": "float",
                "currentValue": "$tag.app().level_reading:number:null",
                "decPrecision": 2,
                "live": true
            },
            "volume": {
                "name": "volume",
                "type": "uiVariable",
                "displayString": "Tank Volume",
                "showActivity": true,
                "position": 54,
                "hidden": true,
                "units": "L",
                "varType": "float",
                "currentValue": "$tag.app().level_volume:number:null",
                "decPrecision": 0
            },
            "alarm_point": {
                "name": "alarm_point",
                "type": "uiSlider",
                "displayString": "Alarm Point",
                "position": 55,
                "hidden": true,
                "currentValue": "$cmds.app().alarm_point",
                "min": 0,
                "max": 100,
                "stepSize": 0.1,
                "dualSlider": false,
                "isInverted": false
            },
            "alarm_range": {
                "name": "alarm_range",
                "type": "uiSlider",
                "displayString": "Allowed Range",
                "position": 56,
                "hidden": true,
                "currentValue": "$cmds.app().alarm_range",
                "min": 0,
                "max": 100,
                "stepSize": 0.1,
                "dualSlider": true,
                "isInverted": false
            },
            "sensor_calibration": {
                "name": "sensor_calibration",
                "type": "uiSubmodule",
                "displayString": "Sensor Calibration",
                "showActivity": true,
                "position": 61,
                "hidden": true,
                "children": {
                    "zero_m": {
                        "name": "zero_m",
                        "type": "uiFloatInput",
                        "displayString": "Zero - level at 4 mA (m)",
                        "position": 57,
                        "hidden": false,
                        "currentValue": "$cmds.app().zero_m",
                        "min": -100.0,
                        "max": 100.0
                    },
                    "span_m": {
                        "name": "span_m",
                        "type": "uiFloatInput",
                        "displayString": "Span - level at 20 mA (m)",
                        "position": 58,
                        "hidden": false,
                        "currentValue": "$cmds.app().span_m",
                        "min": 0.0,
                        "max": 100.0
                    },
                    "fluid_density": {
                        "name": "fluid_density",
                        "type": "uiFloatInput",
                        "displayString": "Fluid Density (kg/m³)",
                        "position": 59,
                        "hidden": false,
                        "currentValue": "$cmds.app().fluid_density",
                        "min": 500.0,
                        "max": 2500.0
                    },
                    "reset_calibration": {
                        "name": "reset_calibration",
                        "type": "uiButton",
                        "displayString": "Reset to configured values",
                        "position": 60,
                        "hidden": false,
                        "currentValue": "$cmds.app().reset_calibration",
                        "requiresConfirm": true
                    }
                }
            }
        }
    },
    "notification_schema": {
        "level_alarm": {
            "event": "level_alarm",
            "display_name": "Level alarm",
            "message": "The level has crossed its alarm setpoint",
            "severity": "Warn",
            "policy": "default",
            "description": "Sent when the reading crosses the configured alarm setpoint, and again on each renotify interval while it stays there."
        }
    }
}
